{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "approval-document-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/approvalDocument/ApprovalDocumentWebPart.js",
          "manifest": "./src/webparts/approvalDocument/ApprovalDocumentWebPart.manifest.json"
        }
      ]
    },
    "hide-app-bar-extension": {
      "components": [
        {
          "entrypoint": "./lib/extensions/hideAppBar/HideAppBarApplicationCustomizer.js",
          "manifest": "./src/extensions/hideAppBar/HideAppBarApplicationCustomizer.manifest.json"
        }
      ]
    },
    "form-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/form/FormWebPart.js",
          "manifest": "./src/webparts/form/FormWebPart.manifest.json"
        }
      ]
    },
    "bulk-upload-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/bulkUpload/BulkUploadWebPart.js",
          "manifest": "./src/webparts/bulkUpload/BulkUploadWebPart.manifest.json"
        }
      ]
    },
    "folder-manager-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/folderManager/FolderManagerWebPart.js",
          "manifest": "./src/webparts/folderManager/FolderManagerWebPart.manifest.json"
        }
      ]
    },
    "onboarding-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/onboarding/OnboardingWebPart.js",
          "manifest": "./src/webparts/onboarding/OnboardingWebPart.manifest.json"
        }
      ]
    },
    "user-access-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/userAccess/UserAccessWebPart.js",
          "manifest": "./src/webparts/userAccess/UserAccessWebPart.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "FormWebPartStrings": "lib/webparts/form/loc/{locale}.js",
    "BulkUploadWebPartStrings": "lib/webparts/bulkUpload/loc/{locale}.js",
    "FolderManagerWebPartStrings": "lib/webparts/folderManager/loc/{locale}.js",
    "OnboardingWebPartStrings": "lib/webparts/onboarding/loc/{locale}.js",
    "UserAccessWebPartStrings": "lib/webparts/userAccess/loc/{locale}.js"
  }
}
