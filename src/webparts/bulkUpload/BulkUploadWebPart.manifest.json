    "group": { "default": "Advanced" },
    "title": { "default": "Bulk Upload" },
    "description": { "default": "Temporary tool: upload up to 50 files straight into the Documents library, bypassing Staging approval." },
    "officeFabricIconFontName": "BulkUpload",
    "properties": {
      "description": "Bulk Upload"
    }
  }]
