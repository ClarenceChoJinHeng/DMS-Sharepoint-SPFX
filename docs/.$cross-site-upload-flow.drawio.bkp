<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0">
  <diagram id="cross-site-upload" name="Cross-Site Upload Flow">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title band -->
        <mxCell id="title" value="SharePoint DMS — Cross-Site Upload" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;strokeColor=#000000;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="770" height="30" as="geometry" />
        </mxCell>

        <!-- Lane headers -->
        <mxCell id="hUp" value="Uploader (Site A)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=13;strokeColor=#000000;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="270" height="30" as="geometry" />
        </mxCell>
        <mxCell id="hAp" value="Approver" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=13;strokeColor=#000000;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="310" y="50" width="270" height="30" as="geometry" />
        </mxCell>
        <mxCell id="hVw" value="Viewer (Destination Site)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=13;strokeColor=#000000;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="580" y="50" width="230" height="30" as="geometry" />
        </mxCell>

        <!-- Lane divider columns -->
        <mxCell id="colUp" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="270" height="940" as="geometry" />
        </mxCell>
        <mxCell id="colAp" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="310" y="80" width="270" height="940" as="geometry" />
        </mxCell>
        <mxCell id="colVw" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="580" y="80" width="230" height="940" as="geometry" />
        </mxCell>

        <!-- ===== Uploader lane nodes (x range 40-310) ===== -->
        <mxCell id="start" value="Start" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="115" y="100" width="120" height="45" as="geometry" />
        </mxCell>

        <mxCell id="form" value="Custom Upload Form (SPFx):&#10;&#8226; select multiple files&#10;&#8226; select metadata (segment, dept, unit, doc type, year)&#10;&#8226; realtime file-format check" style="whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="75" y="180" width="200" height="120" as="geometry" />
        </mxCell>

        <mxCell id="tag" value="Update metadata, rename file, validate file format (SPFx)" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="75" y="340" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="upload" value="Files uploaded to Staging library (Site A) for approval" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="75" y="450" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="notifyApproved" value="Received notification&#10;(approved — with folder / file link on destination site)" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="75" y="690" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="notifyRejected" value="Received notification&#10;(rejected)" style="whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="75" y="880" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- ===== Approver lane nodes (x range 310-580) ===== -->
        <mxCell id="review" value="Access Staging library to review uploaded files (custom SPFx page)" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="345" y="180" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="approve" value="Approve?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="385" y="320" width="120" height="90" as="geometry" />
        </mxCell>

        <mxCell id="autoroute" value="Power Automate — Auto-route&#10;Copies approved file by live folder path to the destination site's final library (rename-proof, metadata-driven)" style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="345" y="480" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="sendReject" value="Send rejection notification via Power Automate" style="whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="345" y="880" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- ===== Viewer lane nodes (x range 580-810) ===== -->
        <mxCell id="goFolder" value="Go to specific folder (destination site library)" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="605" y="340" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="viewDocs" value="View the approved documents" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="605" y="500" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- ===== Edges ===== -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="start" target="form" />
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="form" target="tag" />
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="tag" target="upload" />
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="upload" target="review" />
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="review" target="approve" />

        <mxCell id="e6" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontStyle=1;" edge="1" parent="1" source="approve" target="autoroute" />
        <mxCell id="e7" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontStyle=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="approve" target="sendReject" />

        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="autoroute" target="viewDocs" />
        <mxCell id="e9" value="Send notification (approved)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="autoroute" target="notifyApproved" />
        <mxCell id="e10" value="Send notification (rejected)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="sendReject" target="notifyRejected" />
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="goFolder" target="viewDocs" />
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
