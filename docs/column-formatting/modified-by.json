{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/column-formatting.schema.json",
  "elmType": "div",
  "style": {
    "display": "=if([$File_x0020_Type] == '', 'none', 'flex')",
    "align-items": "center",
    "height": "70%",
    "min-width": "0"
  },
  "children": [
    {
      "elmType": "span",
      "txtContent": "@currentField.title",
      "defaultHoverField": "@currentField",
      "style": {
        "background-color": "#f3f2f1",
        "color": "#323130",
        "border-radius": "15px",
        "padding": "4px 8px",
        "font-size": "12px",
        "display": "inline-block",
        "min-height": "min-content",
        "flex": "0 0 auto",
        "margin": "0",
        "text-align": "left",
        "white-space": "nowrap",
        "overflow": "hidden",
        "text-overflow": "ellipsis",
        "max-width": "100%"
      }
    }
  ]
}
