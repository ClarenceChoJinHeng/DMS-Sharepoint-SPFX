{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/column-formatting.schema.json",
  "elmType": "div",
  "style": {
    "display": "=if([$File_x0020_Type] == '', 'none', 'flex')",
    "align-items": "center",
    "height": "0%",
    "min-width": "0"
  },
  "children": [
    {
      "elmType": "span",
      "txtContent": "=if(Number(@currentField) == 0, 'Approved', if(Number(@currentField) == 1, 'Rejected', if(Number(@currentField) == 2, 'Waiting for Approval', if(Number(@currentField) == 3, 'Draft', 'Scheduled'))))",
      "style": {
        "background-color": "=if(Number(@currentField) == 0, '#dff6dd', if(Number(@currentField) == 1, 'rgba(249, 203, 203, 1)', if(Number(@currentField) == 2, 'rgba(255, 225, 159, 1)', '#f3f2f1')))",
        "color": "=if(Number(@currentField) == 0, '#107c10', if(Number(@currentField) == 1, 'rgba(218, 59, 59, 1)', if(Number(@currentField) == 2, 'rgba(199, 136, 0, 1)', '#605e5c')))",
        "border-radius": "15px",
        "padding": "4px 12px",
        "font-weight": "600",
        "font-size": "12px",
        "display": "inline-block",
        "min-height": "min-content",
        "flex": "0 0 auto",
        "margin": "0",
        "text-align": "center",
        "white-space": "nowrap"
      }
    }
  ]
}
