{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/column-formatting.schema.json",
  "elmType": "div",
  "style": {
    "display": "=if([$File_x0020_Type] == '', 'none', 'flex')",
    "align-items": "center",
    "height": "0%",
    "min-width": "0"
  },
  "children": [
    {
      "elmType": "span",
      "txtContent": "=if(@currentField, 'Yes', 'No')",
      "style": {
        "background-color": "=if(@currentField, 'rgba(255, 225, 159, 1)', '#f3f2f1')",
        "color": "=if(@currentField, 'rgba(199, 136, 0, 1)', '#605e5c')",
        "border-radius": "15px",
        "padding": "4px 12px",
        "font-weight": "600",
        "font-size": "12px",
        "display": "inline-block",
        "min-height": "min-content",
        "flex": "0 0 auto",
        "margin": "0",
        "text-align": "center",
        "white-space": "nowrap"
      }
    }
  ]
}
